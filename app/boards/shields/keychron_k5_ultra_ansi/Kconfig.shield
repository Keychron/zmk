config SHIELD_KEYCHRON_K5_ULTRA_ANSI
    def_bool $(shields_list_contains,keychron_k5_ultra_ansi)
    select SHIELD_KEYCHRON_V1MAX  
    select KEYCHRON_RGB_ENABLE
    select SNAP_CLICK_ENABLE
    select RETAIL_DEMO_ENABLE
    select ADAPATIVE_NKRO
    select MAC_VIA_FUNC
    # select FAST_KSCAN
    select ADD_PPT_REPORT_RATE
    select ENABLE_GPIO_LED
    # select ENABLE_WIN_LOCK
    # select ENABLE_WIN_LOCK_INDICATOR
    select LED_595_OUTPUT
    # select COL_595_OUTPUT
    # select COL_595_AND_GPIOS_OUTPUT
    select DEFAULT_1K_REPORT_RATE
    select ENABLE_FLASH_PROTECT


